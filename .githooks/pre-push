#!/usr/bin/env bash
# Versioned git hook (activate with: git config core.hooksPath .githooks)
# - forbids pushing to main/master
# - runs the quality gates the pushed commits affect: `./mvnw verify` for backend changes (unit + integration tests,
#   architecture rules, coverage gate, formatting) and the frontend checks (Prettier, ESLint, tsc, Vitest with
#   coverage) for changes under frontend/. When the pushed range cannot be determined, both run.
set -euo pipefail
source "$(git rev-parse --show-toplevel)/.claude/hooks/lib.sh"

zero="0000000000000000000000000000000000000000"
changed=""
unknown=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
        echo "pre-push: pushing to '${remote_ref#refs/heads/}' is not allowed. Push a branch and open a PR." >&2
        exit 1
      fi
      ;;
  esac
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" != "$zero" ]; then
    base="$remote_sha"
  else
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  fi
  if [ -n "$base" ] && git cat-file -e "$base^{commit}" 2>/dev/null; then
    changed+="$(git diff --name-only "$base" "$local_sha")"$'\n'
  else
    unknown=1
  fi
done

if [ "$unknown" = 1 ]; then
  gates=$'backend\nfrontend'
else
  gates="$(printf '%s' "$changed" | classify_paths)"
fi

if grep -qx backend <<<"$gates"; then
  echo "pre-push: running ./mvnw verify ..."
  if ! ./mvnw -q -B verify; then
    echo "pre-push: build failed, push aborted." >&2
    exit 1
  fi
fi
if grep -qx frontend <<<"$gates" && [ -f frontend/package.json ]; then
  echo "pre-push: running the frontend checks ..."
  if ! run_frontend_checks; then
    echo "pre-push: frontend checks failed, push aborted." >&2
    exit 1
  fi
fi
[ -n "$gates" ] || echo "pre-push: no backend or frontend changes, skipping the build."
